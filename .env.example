# =================================================================
# AXION PLATFORM ENVIRONMENT CONFIGURATION
# Positioning: "From Data → Intelligence → Action"
# =================================================================

# Claude API Key (Anthropic SDK)
# Used for Returns reasoning, Expense policy evaluation, and Business Copilot
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database Connection URL (Vercel Postgres, Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/axion_db?schema=public"

# Optional: Vector Database / RAG layer configuration (pgvector / Pinecone)
ENABLE_VECTOR_RAG="false"
PINECONE_API_KEY=""
PINECONE_INDEX=""

# App URL (optional for production deployment)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
